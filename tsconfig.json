{
  "compilerOptions": {
    "module": "esnext",
    "target": "ESNext",
    "jsx": "react-jsx",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["src", "playwright", "vite.config.ts", "playwright.config.ts"],
  "exclude": ["node_modules", "lib"]
}
