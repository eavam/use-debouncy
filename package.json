{
  "name": "use-debouncy",
  "version": "6.0.0",
  "description": "🌀 Small (~0.2kb) debounce effect hook for React with TypeScript support",
  "keywords": [
    "debounce",
    "debounce hook",
    "hooks",
    "react",
    "react debounce",
    "react hook",
    "typescript",
    "use-debounce",
    "use-debouncy",
    "use-effect"
  ],
  "license": "MIT",
  "author": "Egor Avakumov",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eavam/use-debouncy.git"
  },
  "files": [
    "lib/"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./lib/index.cjs",
  "module": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "react-native": {
        "types": "./lib/index.d.cts",
        "default": "./lib/index.cjs"
      },
      "import": {
        "types": "./lib/index.d.ts",
        "default": "./lib/index.js"
      },
      "require": {
        "types": "./lib/index.d.cts",
        "default": "./lib/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "dev": "vite",
    "test": "playwright test",
    "lint": "oxlint --fix && oxfmt",
    "lint:check": "oxlint && oxfmt --check",
    "build": "vite build && tsc -p tsconfig.build.json && cp lib/index.d.ts lib/index.d.cts",
    "release": "release-it",
    "typecheck": "tsc",
    "hooks": "simple-git-hooks"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@release-it/conventional-changelog": "12.0.0",
    "@types/node": "26.3.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "release-it": "21.0.2",
    "simple-git-hooks": "2.13.1",
    "typescript": "7.0.2",
    "vite": "8.2.2"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "simple-git-hooks": {
    "pre-commit": "yarn lint"
  },
  "packageManager": "yarn@4.18.0"
}
