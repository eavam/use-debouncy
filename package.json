{
  "name": "use-debouncy",
  "version": "5.1.7",
  "author": "Egor Avakumov",
  "description": "🌀 Small (~0.2kb) debounce effect hook for React with TypeScript support",
  "license": "MIT",
  "keywords": [
    "debounce",
    "use-debounce",
    "react debounce",
    "debounce hook",
    "use-debouncy",
    "use-effect",
    "react",
    "react hook",
    "hooks",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eavam/use-debouncy.git"
  },
  "main": "lib/index.js",
  "typings": "lib/index.d.ts",
  "module": "lib/index.mjs",
  "sideEffects": false,
  "scripts": {
    "dev": "vite",
    "test": "playwright test",
    "lint": "yarn biome check --write .",
    "build": "tsup",
    "release": "release-it"
  },
  "peerDependencies": {
    "react": "^16.8.0 || ^17.0.0 || ^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@playwright/test": "1.62.0",
    "@release-it/conventional-changelog": "12.0.0",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "release-it": "21.0.0",
    "simple-git-hooks": "2.13.1",
    "terser": "5.44.1",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vite": "8.1.5"
  },
  "files": [
    "lib/"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "packageManager": "yarn@4.12.0",
  "simple-git-hooks": {
    "pre-commit": "yarn biome check --staged --files-ignore-unknown=true --no-errors-on-unmatched"
  }
}
